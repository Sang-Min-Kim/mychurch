{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiet-sanctuary-parish",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SANCTUARY_HUB",
        "class_name": "SanctuaryHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SanctuaryHub"]
    }
  ],
  "vars": {
    "PARISH_ADMIN_CODE": "1225"
  }
}
